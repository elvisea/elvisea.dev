# Variáveis de ambiente do elvisea.dev.
# Copie para `.env.local` em desenvolvimento. Nunca versione valores reais.

# --- Formulário de contato (/contato) ---
# Transporte: `console` (só log, padrão fora de produção) ou `smtp`.
# Em produção, sem EMAIL_TRANSPORT o formulário responde erro em vez de enviar.
EMAIL_TRANSPORT=console
# Quem recebe as mensagens e o remetente usado ("Nome <email>" ou só email).
EMAIL_TO=
EMAIL_FROM=
# SMTP (quando EMAIL_TRANSPORT=smtp). Porta 465 usa TLS direto.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Header com o IP real do visitante, usado no rate limit. Atrás da Cloudflare:
# cf-connecting-ip. Padrão: primeiro valor de x-forwarded-for.
TRUSTED_IP_HEADER=

# --- Logs ---
# `pretty` (JSON indentado) ou `json` (uma linha por evento).
# Sem valor: `json` em produção e `pretty` no resto.
LOG_FORMAT=

# --- Sync de projetos (bun run sync:github) ---
# Opcional: só aumenta o limite de requisições da API do GitHub.
GITHUB_TOKEN=
