{
  "name": "elvisea.dev",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint",
    "lint:fix": "bunx --bun eslint . --fix",
    "format": "bunx --bun prettier --write .",
    "format:check": "bunx --bun prettier --check .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "security:check": "bun audit --audit-level=high",
    "docker:build": "docker build -t elvisea.dev:local .",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up -d --build",
    "docker:stop": "docker compose down",
    "typecheck": "bun --bun next typegen && tsc --noEmit",
    "sync:github": "bun run scripts/sync-github.ts",
    "teaser": "bun --conditions=react-server run scripts/teaser.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.46.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "simple-icons": "^16.31.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
